{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; connect-src 'self' https://challenges.cloudflare.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://challenges.cloudflare.com; frame-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*;"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://kyreqo-api.onrender.com/api/$1"
    },
    {
      "source": "/admin/(.*)",
      "destination": "https://kyreqo-api.onrender.com/admin/$1"
    },
    {
      "source": "/static/admin/(.*)",
      "destination": "https://kyreqo-api.onrender.com/static/admin/$1"
    },
    {
      "source": "/((?!api|admin|static/admin|assets|favicon.png|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}
